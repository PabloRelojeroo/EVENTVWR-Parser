<Window x:Class="EventvwrParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVENTVWR Parser" Height="800" Width="1360" MinWidth="1100" MinHeight="580"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EVENTVWR" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text=" Parser" FontSize="16" Foreground="{StaticResource Muted}"/>
                    <Border Style="{StaticResource Chip}" Margin="18,0,0,0">
                        <TextBlock x:Name="BootText" FontSize="12" Foreground="{StaticResource Muted}" Text="Boot —"/>
                    </Border>
                    <Border x:Name="LogonChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock x:Name="LogonText" FontSize="12" Foreground="{StaticResource Accent}" Text="Logon —"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="340"
                             TextChanged="OnInputChanged"/>
                    <TextBox x:Name="IdsBox" Style="{StaticResource Input}" Width="150" Margin="8,0,0,0"
                             Tag="IDs: 400,600,800" TextChanged="OnInputChanged"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnRefresh"/>
                    <Button x:Name="LanguageButton" Style="{StaticResource BtnGhost}" Padding="10,7" Margin="8,0,0,0" Click="OnLanguage"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,16,18">
                        <CheckBox x:Name="OnlyInstance" Checked="OnToggle" Unchecked="OnToggle"/>
                        <CheckBox x:Name="HideNoise" IsChecked="True" Margin="0,12,0,0"
                                  Checked="OnToggle" Unchecked="OnToggle"/>
                    </StackPanel>
                    <TextBlock x:Name="CategoriesCaption" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="20,16,0,8"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SideItem}" SelectionChanged="OnCategoryChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}" Foreground="{Binding Brush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Muted}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="280" MinHeight="120"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="EventsGrid" SelectionChanged="OnEventSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="TimeColumn" Binding="{Binding TimeText}" SortMemberPath="Time" Width="176">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" SortMemberPath="Id" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding TypeText}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="SummaryColumn" Binding="{Binding SummaryText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="" Binding="{Binding RelatedText}" SortMemberPath="Related" Width="46">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="FLAGS" Width="190" SortMemberPath="IsFileless">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#33FF5C6C" CornerRadius="4" Padding="6,1"
                                                Visibility="{Binding IsFileless, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="FILELESS" Foreground="{StaticResource Red}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="LoadingOverlay" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LoadingTitle" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingHint" Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="18,12,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DetTitle" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetMeta" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="CopyButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource BtnGhost}" Padding="12,5" Click="OnCopy"/>
                        </Grid>
                        <ItemsControl x:Name="DetReasons" Grid.Row="1" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22FF5C6C" CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" Foreground="#FF8A95" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="DetText" Grid.Row="2" Style="{StaticResource Code}" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="WarnText" Foreground="{StaticResource Orange}" FontSize="12" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="760"/>
            </Grid>
        </Border>
    </Grid>
</Window>
